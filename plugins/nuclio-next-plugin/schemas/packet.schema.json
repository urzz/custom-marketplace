{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuclio-next.local/schemas/packet.schema.json",
  "title": "Nuclio Next Agent Packet",
  "description": "Shape schema for worker, reviewer, completion and finish packets; helper scripts derive packets from contract/context/state and validate path and snapshot semantics fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "role",
    "change_id",
    "contract_sha256",
    "context_fingerprint",
    "state_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "packet_id": {
      "$ref": "#/$defs/sha256"
    },
    "role": {
      "enum": [
        "worker",
        "reviewer",
        "completion",
        "finish"
      ]
    },
    "change_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "context_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "ownership": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownership_entry"
      }
    },
    "range": {
      "$ref": "#/$defs/vcs_range"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "checks": {
      "$ref": "#/$defs/checks"
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "review_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "task_heads": {
      "$ref": "#/$defs/identity_map"
    },
    "implementation_range": {
      "$ref": "#/$defs/completion_range"
    },
    "acceptance_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "task_evidence": {
      "$ref": "#/$defs/sha_identity_map"
    },
    "task_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mutation_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "completion_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "finish_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "knowledge_proposal": {
      "$ref": "#/$defs/non_empty_json"
    },
    "knowledge_targets": {
      "$ref": "#/$defs/finish_targets"
    },
    "archive_targets": {
      "$ref": "#/$defs/finish_targets"
    },
    "archive_intent": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "worker"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "ownership",
          "range",
          "snapshots",
          "checks"
        ],
        "properties": {
          "ownership": {
            "minItems": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "review_targets"
              ]
            },
            {
              "required": [
                "task_heads"
              ]
            },
            {
              "required": [
                "implementation_range"
              ]
            },
            {
              "required": [
                "acceptance_index_sha256"
              ]
            },
            {
              "required": [
                "task_evidence"
              ]
            },
            {
              "required": [
                "task_evidence_sha256"
              ]
            },
            {
              "required": [
                "mutation_map_sha256"
              ]
            },
            {
              "required": [
                "completion_sha256"
              ]
            },
            {
              "required": [
                "decision_sha256"
              ]
            },
            {
              "required": [
                "finish_plan_sha256"
              ]
            },
            {
              "required": [
                "knowledge_proposal"
              ]
            },
            {
              "required": [
                "knowledge_targets"
              ]
            },
            {
              "required": [
                "archive_targets"
              ]
            },
            {
              "required": [
                "archive_intent"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "reviewer"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "ownership",
          "range",
          "snapshots",
          "checks",
          "review_targets"
        ],
        "properties": {
          "review_targets": {
            "minItems": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "task_heads"
              ]
            },
            {
              "required": [
                "implementation_range"
              ]
            },
            {
              "required": [
                "acceptance_index_sha256"
              ]
            },
            {
              "required": [
                "task_evidence"
              ]
            },
            {
              "required": [
                "task_evidence_sha256"
              ]
            },
            {
              "required": [
                "completion_sha256"
              ]
            },
            {
              "required": [
                "decision_sha256"
              ]
            },
            {
              "required": [
                "finish_plan_sha256"
              ]
            },
            {
              "required": [
                "knowledge_proposal"
              ]
            },
            {
              "required": [
                "knowledge_targets"
              ]
            },
            {
              "required": [
                "archive_targets"
              ]
            },
            {
              "required": [
                "archive_intent"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "completion"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "task_heads",
          "implementation_range",
          "acceptance_index_sha256",
          "task_evidence",
          "task_evidence_sha256",
          "mutation_map_sha256",
          "checks",
          "handoffs"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "task_id"
              ]
            },
            {
              "required": [
                "ownership"
              ]
            },
            {
              "required": [
                "review_targets"
              ]
            },
            {
              "required": [
                "completion_sha256"
              ]
            },
            {
              "required": [
                "decision_sha256"
              ]
            },
            {
              "required": [
                "finish_plan_sha256"
              ]
            },
            {
              "required": [
                "knowledge_proposal"
              ]
            },
            {
              "required": [
                "knowledge_targets"
              ]
            },
            {
              "required": [
                "archive_targets"
              ]
            },
            {
              "required": [
                "archive_intent"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "finish"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "completion_sha256",
          "decision_sha256",
          "finish_plan_sha256",
          "knowledge_proposal",
          "knowledge_targets",
          "archive_targets",
          "archive_intent",
          "snapshots"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "task_id"
              ]
            },
            {
              "required": [
                "ownership"
              ]
            },
            {
              "required": [
                "checks"
              ]
            },
            {
              "required": [
                "handoffs"
              ]
            },
            {
              "required": [
                "review_targets"
              ]
            },
            {
              "required": [
                "task_heads"
              ]
            },
            {
              "required": [
                "implementation_range"
              ]
            },
            {
              "required": [
                "acceptance_index_sha256"
              ]
            },
            {
              "required": [
                "task_evidence"
              ]
            },
            {
              "required": [
                "task_evidence_sha256"
              ]
            },
            {
              "required": [
                "mutation_map_sha256"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "vcs_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_json": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "identity_map": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[^\\s]+$": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "sha_identity_map": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[^\\s]+$": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ownership_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "mode": {
          "enum": [
            "create",
            "modify",
            "delete",
            "read"
          ]
        },
        "sha256_before": {
          "$ref": "#/$defs/sha256_or_null"
        }
      }
    },
    "vcs_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_head",
        "expected_dirty_state"
      ],
      "properties": {
        "base_head": {
          "$ref": "#/$defs/vcs_ref"
        },
        "new_head": {
          "$ref": "#/$defs/vcs_ref"
        },
        "expected_dirty_state": {
          "enum": [
            "clean",
            "owned_paths_only"
          ]
        }
      }
    },
    "completion_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "head"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/vcs_ref"
        },
        "head": {
          "$ref": "#/$defs/vcs_ref"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "state"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "state": {
          "enum": [
            "absent",
            "present",
            "deleted"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focused",
        "full"
      ],
      "properties": {
        "focused": {
          "$ref": "#/$defs/check_list"
        },
        "full": {
          "$ref": "#/$defs/check_list"
        },
        "change_wide": {
          "$ref": "#/$defs/check_list"
        }
      }
    },
    "check_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/non_empty_string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "finish_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finish_target"
      }
    },
    "finish_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/dev_docs_target_path"
        },
        "before_sha256": {
          "$ref": "#/$defs/sha256_or_null"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$)|/$|^\\.git(/|$))"
      }
    },
    "dev_docs_target_path": {
      "type": "string",
      "pattern": "^\\.dev-docs/(knowledge/[^/].*|archive/[^/].*|index\\.(md|json))$",
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$)|/$)"
      }
    }
  }
}
