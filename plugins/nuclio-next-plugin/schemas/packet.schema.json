{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuclio-next.local/schemas/packet.schema.json",
  "title": "Nuclio Next Agent Packet",
  "description": "Shape schema for worker, reviewer, completion and finish packets; helper scripts derive packets from contract/context/state and validate path and snapshot semantics fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "role",
    "change_id",
    "contract_sha256",
    "context_fingerprint",
    "state_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "role": {
      "enum": [
        "worker",
        "reviewer",
        "completion",
        "finish"
      ]
    },
    "change_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "context_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "ownership": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownership_entry"
      }
    },
    "range": {
      "$ref": "#/$defs/implementation_range"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "checks": {
      "$ref": "#/$defs/checks"
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "review_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "mutation_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "completion_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "finish_plan_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "worker"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "ownership",
          "range",
          "snapshots",
          "checks"
        ],
        "properties": {
          "ownership": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "reviewer"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "ownership",
          "range",
          "snapshots",
          "checks",
          "review_targets"
        ],
        "properties": {
          "review_targets": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "completion"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "mutation_map_sha256",
          "checks",
          "handoffs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "finish"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "completion_sha256",
          "decision_sha256",
          "finish_plan_sha256",
          "snapshots"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vcs_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "ownership_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mode": {
          "enum": [
            "create",
            "modify",
            "delete",
            "read"
          ]
        },
        "sha256_before": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "implementation_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_head",
        "expected_dirty_state"
      ],
      "properties": {
        "base_head": {
          "$ref": "#/$defs/vcs_ref"
        },
        "new_head": {
          "$ref": "#/$defs/vcs_ref"
        },
        "expected_dirty_state": {
          "enum": [
            "clean",
            "owned_paths_only"
          ]
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "state"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "state": {
          "enum": [
            "absent",
            "present",
            "deleted"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focused",
        "full"
      ],
      "properties": {
        "focused": {
          "$ref": "#/$defs/check_list"
        },
        "full": {
          "$ref": "#/$defs/check_list"
        },
        "change_wide": {
          "$ref": "#/$defs/check_list"
        }
      }
    },
    "check_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/non_empty_string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
