{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuclio.local/schemas/state.schema.json",
  "title": "Nuclio State",
  "description": "Shape schema for .dev-docs/changes/<change-id>/state.json; helper scripts validate transition legality, freshness, dirty state and artifact identity fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_version",
    "change_id",
    "status",
    "contract",
    "context",
    "gates",
    "tasks",
    "blockers",
    "fix_budgets",
    "history"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "idle",
        "drafting_contract",
        "contract_pending",
        "ready_to_execute",
        "executing",
        "completing",
        "decision_pending",
        "folding",
        "archived",
        "repair_required",
        "context_stale",
        "deferred",
        "rejected"
      ]
    },
    "contract": {
      "$ref": "#/$defs/artifact_identity"
    },
    "context": {
      "$ref": "#/$defs/context_identity"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "finish"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/gate_ledger"
        },
        "finish": {
          "$ref": "#/$defs/gate_ledger"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task_state"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "fix_budgets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maximum",
          "used",
          "remaining"
        ],
        "properties": {
          "maximum": {
            "type": "integer",
            "minimum": 0
          },
          "used": {
            "type": "integer",
            "minimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "completion": {
      "$ref": "#/$defs/completion_identity"
    },
    "decision": {
      "$ref": "#/$defs/decision_identity"
    },
    "legacy_evidence": {
      "type": "object"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history_event"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "archived",
              "folding"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completion",
          "decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "archived",
              "folding"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completion": {
            "$ref": "#/$defs/canonical_completion_identity"
          },
          "decision": {
            "$ref": "#/$defs/canonical_decision_identity"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "const": "decision_pending"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "anyOf": [
              {
                "properties": {
                  "completion": {
                    "required": [
                      "completion_sha256"
                    ]
                  }
                },
                "required": [
                  "completion"
                ]
              },
              {
                "properties": {
                  "decision": {
                    "required": [
                      "finish_plan_sha256"
                    ]
                  }
                },
                "required": [
                  "decision"
                ]
              },
              {
                "properties": {
                  "decision": {
                    "required": [
                      "decision_state_version"
                    ]
                  }
                },
                "required": [
                  "decision"
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "completion": {
            "$ref": "#/$defs/canonical_completion_identity"
          },
          "decision": {
            "$ref": "#/$defs/canonical_decision_identity"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "language_tag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version",
        "output_language"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "output_language": {
          "$ref": "#/$defs/language_tag"
        }
      }
    },
    "context_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "fingerprint",
        "entries"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "gate_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "none",
            "pending",
            "approved",
            "deferred",
            "rejected",
            "stale"
          ]
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "approval_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "approved_at": {
          "$ref": "#/$defs/non_empty_string"
        },
        "decision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "notes": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "task_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "ownership"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "implementing",
            "reviewing",
            "fixing",
            "completed",
            "blocked",
            "rejected"
          ]
        },
        "ownership": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "implementing",
                  "reviewing",
                  "fixing",
                  "completed",
                  "blocked",
                  "rejected"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "packet_sha256"
            ]
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocking"
          ]
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner": {
          "$ref": "#/$defs/non_empty_string"
        },
        "task_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_gate": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "completion_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_sha256",
        "mutation_map_sha256",
        "state_version"
      ],
      "properties": {
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "completion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proposal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mutation_map_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_heads": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "implementation_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "head"
          ],
          "properties": {
            "base": {
              "$ref": "#/$defs/non_empty_string"
            },
            "head": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        },
        "acceptance_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "canonical_completion_identity": {
      "allOf": [
        {
          "$ref": "#/$defs/completion_identity"
        },
        {
          "required": [
            "contract_sha256",
            "context_fingerprint",
            "completion_sha256",
            "proposal_sha256",
            "mutation_map_sha256",
            "task_heads",
            "implementation_range",
            "acceptance_index_sha256",
            "state_version"
          ]
        }
      ]
    },
    "decision_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_sha256",
        "state_version",
        "approved"
      ],
      "properties": {
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "completion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proposal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mutation_map_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_heads": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "implementation_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "head"
          ],
          "properties": {
            "base": {
              "$ref": "#/$defs/non_empty_string"
            },
            "head": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        },
        "acceptance_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "finish_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision_state_version": {
          "type": "integer",
          "minimum": 1
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "canonical_decision_identity": {
      "allOf": [
        {
          "$ref": "#/$defs/decision_identity"
        },
        {
          "required": [
            "contract_sha256",
            "context_fingerprint",
            "completion_sha256",
            "proposal_sha256",
            "mutation_map_sha256",
            "task_heads",
            "implementation_range",
            "acceptance_index_sha256",
            "decision_sha256",
            "finish_plan_sha256",
            "decision_state_version",
            "state_version",
            "approved"
          ]
        }
      ]
    },
    "history_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "from",
        "to",
        "state_version"
      ],
      "properties": {
        "event": {
          "$ref": "#/$defs/non_empty_string"
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "$ref": "#/$defs/non_empty_string"
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
