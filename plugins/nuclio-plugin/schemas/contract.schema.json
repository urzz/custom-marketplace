{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuclio.local/schemas/contract.schema.json",
  "title": "Nuclio Contract",
  "description": "Shape schema for .dev-docs/changes/<change-id>/contract.yaml after YAML parsing; helper scripts validate graph, ownership, path and budget semantics fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "contract_version",
    "intent",
    "acceptance",
    "constraints",
    "design",
    "tasks",
    "context_policy",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "context_policy": {
      "$ref": "#/$defs/context_policy"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "migration_or_rollout": {
      "$ref": "#/$defs/migration_or_rollout"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goals",
        "non_goals",
        "confirmed_answers"
      ],
      "properties": {
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "non_goals": {
          "$ref": "#/$defs/string_list"
        },
        "confirmed_answers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "$ref": "#/$defs/non_empty_string"
              },
              "answer": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaries",
        "data_flow",
        "contracts",
        "tradeoffs"
      ],
      "properties": {
        "boundaries": {
          "$ref": "#/$defs/non_empty_string"
        },
        "data_flow": {
          "$ref": "#/$defs/non_empty_string"
        },
        "contracts": {
          "$ref": "#/$defs/non_empty_string"
        },
        "tradeoffs": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "owner",
        "dependencies",
        "mutation_targets",
        "handoffs",
        "checks",
        "rollback"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "uniqueItems": true
        },
        "mutation_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mutation_target"
          }
        },
        "handoffs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputs",
            "outputs"
          ],
          "properties": {
            "inputs": {
              "$ref": "#/$defs/string_list"
            },
            "outputs": {
              "$ref": "#/$defs/string_list"
            },
            "report": {
              "$ref": "#/$defs/non_empty_string"
            },
            "evidence": {
              "$ref": "#/$defs/string_list"
            },
            "review_package": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focused",
            "full"
          ],
          "properties": {
            "focused": {
              "$ref": "#/$defs/check_list"
            },
            "full": {
              "$ref": "#/$defs/check_list"
            }
          }
        },
        "rollback": {
          "$ref": "#/$defs/non_empty_string"
        },
        "review": {
          "$ref": "#/$defs/non_empty_string"
        },
        "fix_budget": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "$ref": "#/$defs/non_empty_string"
        },
        "notes": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "mutation_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mode": {
          "enum": [
            "create",
            "modify",
            "delete"
          ]
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "check_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/non_empty_string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "jit",
        "forbidden",
        "budget"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context_ref"
          }
        },
        "jit": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "retrieval_trigger",
              "budget"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/non_empty_string"
              },
              "retrieval_trigger": {
                "$ref": "#/$defs/non_empty_string"
              },
              "budget": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "enum": [
              "full_conversation",
              "all_docs",
              "all_source",
              "raw_logs",
              "unrelated_tasks",
              "absolute_paths",
              "path_traversal",
              "glob",
              "broad_directory_roots"
            ]
          },
          "uniqueItems": true
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "by_audience": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              },
              "propertyNames": {
                "enum": [
                  "contract",
                  "worker",
                  "reviewer",
                  "completion",
                  "finish"
                ]
              }
            }
          }
        }
      }
    },
    "context_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_empty_string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "reason"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/non_empty_string"
            },
            "reason": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focused",
        "full",
        "change_wide"
      ],
      "properties": {
        "focused": {
          "$ref": "#/$defs/check_list"
        },
        "full": {
          "$ref": "#/$defs/check_list"
        },
        "change_wide": {
          "$ref": "#/$defs/check_list"
        }
      }
    },
    "migration_or_rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection",
        "preview",
        "opt_in",
        "verification",
        "rollback"
      ],
      "properties": {
        "detection": {
          "$ref": "#/$defs/non_empty_string"
        },
        "preview": {
          "$ref": "#/$defs/non_empty_string"
        },
        "opt_in": {
          "$ref": "#/$defs/non_empty_string"
        },
        "verification": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
